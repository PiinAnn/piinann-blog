---
interface Props {
  title?: string;
  lang?: string;
  /** Blog pages: neutral reading theme that follows the system light/dark setting */
  reading?: boolean;
  /** hreflang alternates, e.g. [{ lang: 'zh-Hant', href: '/zh/writings/x' }] */
  alternates?: { lang: string; href: string }[];
}
// Noto Sans TC (思源黑體): Chinese text in mono-styled elements. Split by unicode-range, so pages only load the characters they use.
import '@fontsource/noto-sans-tc/400.css';
import '@fontsource/noto-sans-tc/700.css';
const { title = "Piin Ann 平安", lang = "en", reading = false, alternates = [] } = Astro.props;
---

<!doctype html>
<html lang={lang} class:list={[{ reading }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <script is:inline>
      // Apply a saved manual theme before the page paints (no flash).
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <button class="theme-toggle" type="button" aria-label="Toggle light/dark mode" title="Light / Dark">◐</button>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function current() { return root.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function label() {
          var next = current() === 'dark' ? 'light' : 'dark';
          btn.setAttribute('aria-label', 'Switch to ' + next + ' mode');
          btn.title = 'Switch to ' + next + ' mode';
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
        });
        mq.addEventListener && mq.addEventListener('change', label);
        label();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ---------- Colour themes ----------
     Every page follows the visitor's system light/dark setting.
     The toggle button stores a manual choice in data-theme="light|dark". */

  /* Portfolio (homepage): dark */
  :root {
    color-scheme: dark;
    --pink: #FF4FB4;            /* 6.6:1 on #0a0a0a */
    --pink-soft: #FF9DD6;
    --pink-pale: #FFD0EC;
    --pink-glow: rgba(255, 79, 180, 0.4);
    --bg: #0a0a0a;
    --text: #e8e8e8;
    --text-dim: #9a9a9a;
    --mono: 'Monaco', 'Menlo', 'Consolas', 'Noto Sans TC', 'PingFang TC', monospace;  /* Chinese characters use Noto Sans TC */
    --serif: "Source Serif 4", "Noto Serif TC", Georgia, "Songti TC", serif;
  }
  /* Portfolio: light */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      color-scheme: light;
      --pink: #D6006F;          /* 5.1:1 on white */
      --pink-soft: #C2185B;     /* 5.9:1 on white */
      --pink-pale: #F48FC0;     /* borders only */
      --pink-glow: rgba(214, 0, 111, 0.2);
      --bg: #ffffff;
      --text: #141414;
      --text-dim: #5c5c5c;      /* 6.7:1 on white */
    }
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --pink: #D6006F;
    --pink-soft: #C2185B;
    --pink-pale: #F48FC0;
    --pink-glow: rgba(214, 0, 111, 0.2);
    --bg: #ffffff;
    --text: #141414;
    --text-dim: #5c5c5c;
  }

  /* Reading theme (blog): black and white first, pink for borders, dividers and links */
  :root.reading {
    --bg: #ffffff;
    --text: #141414;
    --text-dim: #5c5c5c;
    --line: rgba(0, 0, 0, 0.12);
    --accent: #D6006F;
    --accent-line: #FF4FB4;
    --accent-faint: rgba(255, 79, 180, 0.35);
  }
  @media (prefers-color-scheme: dark) {
    :root.reading:not([data-theme="light"]) {
      --bg: #0a0a0a;
      --text: #e6e6e6;
      --text-dim: #9a9a9a;      /* 7.0:1 on #0a0a0a */
      --line: rgba(255, 255, 255, 0.14);
      --accent: #FF4FB4;
      --accent-faint: rgba(255, 79, 180, 0.4);
    }
  }
  :root.reading[data-theme="dark"] {
    --bg: #0a0a0a;
    --text: #e6e6e6;
    --text-dim: #9a9a9a;
    --line: rgba(255, 255, 255, 0.14);
    --accent: #FF4FB4;
    --accent-faint: rgba(255, 79, 180, 0.4);
  }

  /* Theme toggle button */
  .theme-toggle {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--pink);
    background: var(--bg);
    color: var(--text);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  :root.reading .theme-toggle { border-color: var(--accent-line); }
  .theme-toggle:hover, .theme-toggle:focus-visible { opacity: 1; }

  :root.reading body {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  :root.reading[lang="zh-Hant"] body {
    line-height: 1.9;
    letter-spacing: 0.02em;
  }

  :root.reading a {
    color: var(--accent);
  }

  :root.reading a:hover {
    border-bottom-color: var(--accent);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    line-height: 1.7;
  }

  a {
    color: var(--pink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  a:hover {
    border-bottom-color: var(--pink);
  }
  .doi-badge {
  display: block;
  margin: 1rem 0 1.5rem 0;
}

  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: 6px;
  }
</style>