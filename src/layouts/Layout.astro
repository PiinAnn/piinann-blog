---
const { title = "Piin Ann 平安" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --pink: #FF4FB4;
    --pink-soft: #FF9DD6;
    --pink-pale: #FFD0EC;
    --pink-glow: rgba(255, 79, 180, 0.4);
    --bg: #0a0a0a;
    --text: #e8e8e8;
    --text-dim: #9a9a9a;
    --mono: 'Monaco', 'Menlo', 'Consolas', monospace;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    line-height: 1.7;
  }

  a {
    color: var(--pink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  a:hover {
    border-bottom-color: var(--pink);
  }
  .doi-badge {
  display: block;
  margin: 1rem 0 1.5rem 0;
}

  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border-radius: 6px;
  }
</style>