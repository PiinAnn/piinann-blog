---
import Layout from '../layouts/Layout.astro';

const featured = [
  {
    title: 'Just Spatial',
    year: '2026',
    image: '/just-spatial.png',
    href: 'https://cycling74.com/articles/spatialization-in-max',
    desc: "Commissioned by Cycling '74 on the theme of spatialization. It splits conflicting frequency partials between the left and right ears, exploring auditory roughness through dichotic listening.",
    links: [
      { label: 'interview & download', url: 'https://cycling74.com/articles/spatialization-in-max' },
      { label: 'preprint', url: 'https://zenodo.org/records/20927968' },
      { label: 'sound demo', url: 'https://youtu.be/45RbisnUYfs' },
    ],
  },
  {
    title: '一起下地獄 To Hell With Me',
    year: '2026',
    yt: 'irSC_9r3td4',
    desc: "Commissioned full score for a free-roaming multiplayer VR experience by Moondream Reality, supported by Taiwan's Ministry of Culture. Previewed at Creative Expo Taiwan, exhibited at Chiayi Cultural and Creative Industries Park.",
    links: [
      { label: 'project', url: 'https://culturetech.taicca.tw/content/204/TO%20HELL%20WITH%20ME' },
    ],
  },
  {
    title: 'Bio-Resonance: Hug Protocol',
    year: '2026',
    yt: 'UNffvZytHyc',
    desc: "Interactive sound and light on a living tree, triggered by hugs and touch. Commissioned by Children's Cultural Services, City of Jyväskylä, for Lasten Lysti 2026, at an event co-organized with the Valon kaupunki festival.",
    links: [
      { label: 'press', url: 'https://www.ksml.fi/paikalliset/9832191' },
      { label: 'programme', url: 'https://online.fliphtml5.com/enxld/esite-syksy2026-verkkoversio-2/#p=10' },
    ],
  },
  {
    title: 'Mutual Care Eco System',
    year: '2026',
    yt: 'fpLnOcR6ADc',
    desc: 'Living plants as an instrument: bio signals mapped from Arduino to Max/MSP and Ableton. Live at Ääniasema experimental music festival.',
    links: [],
  },
  {
    title: 'Nature and Artificial Natures',
    year: '2025',
    yt: 'aRrmEMGAE7A',
    desc: 'Interactive music and sound design for one of the works in the exhibition curated by Chen Pu, AMBI SPACE ONE, Taipei 101. The exhibition received a 2025 Golden Pin Design Award.',
    links: [
      { label: 'walkthrough', url: 'https://www.instagram.com/reel/DKo6dFsPOiv/' },
      { label: 'exhibition', url: 'https://tixfun.com/UTK0201_?PRODUCT_ID=Q01SZKKF' },
      { label: 'award', url: 'https://goldenpin.org.tw/goldenpin/en/winners/2560' },
    ],
  },
  {
    title: 'ASUS ROG',
    year: '2025',
    yt: 'TE469koUF9I',
    desc: 'Interactive sound design for a hand-tracking promotional experience. Ableton and Max/MSP.',
    links: [],
  },
];

const lists = [
  {
    heading: 'Interactive & Game',
    items: [
      { title: 'Running Tempo Modulation', year: '2025', note: "Presented at JYU Researchers' Night 2026", url: 'https://youtu.be/zWKxRp4hFHw', link: 'video' },
      { title: 'Global Game Jam 2026', year: '2026', note: 'Music for 4 teams in 48 hours, Tampere', url: 'https://www.youtube.com/watch?v=8HZnkHqtqyA&list=PLr9AoEH3asMFRVlXP1MhZXJUu1XIyPTtm', link: 'playlist' },
    ],
  },
  {
    heading: 'Live Performance',
    items: [
      { title: 'BOKPAKL', year: '2023–2025', note: 'Music director, cross-media immersive concert series', url: 'https://www.youtube.com/playlist?list=PLV6AYCULKFro', link: 'playlist' },
      { title: 'TSG Hawks Season Opening', year: '2025', note: 'Featured opening guest', url: 'https://youtu.be/JWwraKbkMB0', link: 'video' },
      { title: 'New Taipei City Sonic Wandering Festival', year: '2024', note: 'Opening guest and main stage', url: 'https://youtu.be/O5sM35_VJno', link: 'video' },
      { title: 'Taiwan Lantern Festival', year: '2024', note: 'Featured artist, Tainan' },
      { title: 'Taitung Spirit Festival', year: '2024', note: 'Outdoor performance' },
    ],
    footnote: 'Also: Hong Kong Blindcat, Witch House 女巫店, etc.',
  },
  {
    heading: 'Music Releases',
    items: [
      { title: 'This Is How Waterfall Feels Like', year: '2025', url: 'https://youtu.be/zY8Zv7xyPPs', link: 'video' },
      { title: 'Liquid Fairy', year: '2024', url: 'https://youtu.be/CoIA3Cq_Js4', link: 'video' },
      { title: 'Life On Fire', year: '2023', url: 'https://youtu.be/mAuWD19hWCE', link: 'video' },
      { title: 'Tat Savithur Varenyam', year: '2023', url: 'https://youtu.be/rfGIIY6u-rE', link: 'video' },
      { title: 'Oursong Remix', year: '2023', note: '3rd place, Oursong Remix Competition', url: 'https://youtu.be/jsw6M5Y91Fs', link: 'video' },
    ],
  },
];
---

<Layout title="Piin Ann 平安">
  <main>
    <div class="header">
      <img src="/profile1.jpg" alt="Piin Ann" class="profile-img" />
      <div class="header-text">
        <h1>Piin Ann 平安</h1>
        <p class="subtitle">Interactive Audio Design · Music Producer · Sound Researcher</p>
        <p class="academic-name">academic name: Yun-An Wang</p>
        <p class="location">📍 Currently in Finland, from Taiwan</p>
      </div>
    </div>

    <div class="nav">
      <a href="#about">about</a>
      <a href="#works">works</a>
      <a href="#blog">blog</a>
      <a href="#services">services</a>
    </div>

    <p class="contact">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
      <span class="email-protect" data-user="piinannw" data-domain="gmail.com"></span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.505" y2="6.5"/></svg>
      <a href="https://instagram.com/piin_ann">@piin_ann</a> · <a href="https://instagram.com/piinkcodin">@piinkcodin</a>
    </p>

    <h2 id="about">about~</h2>

    <p class="statement">
      My only intention is to heal people. I found my passion in music and frequencies. I'm just so fascinated of exploring music as a non-verbal communication tool, and want to explore the full potential of sounds and myself. It is sacred for me, whether through my art work or research work.
    </p>

    <p>Applying the scientific rigor of Music & Science to Electronic Music Production and Interactive sound design.</p>

    <p><strong class="label">M.A. Student in Music and Science</strong>, University of Jyväskylä (JYU), Finland</p>
    <p><strong class="label">Research Focus:</strong> Real-time auditory roughness reduction through dichotic listening, and its effects on listener perception.</p>
    <p>Previously the Social Operations Manager for odrclass, Taiwan's largest music education community at the time. Produced 200+ articles and 100+ tutorial videos over two years for the Mandarin-speaking music community.</p>

    <h2 id="works">works~</h2>

    <h3>Featured</h3>

    <div class="featured-grid">
      {featured.map(w => (
        <article class="card">
          {w.yt ? (
            <button class="thumb yt" data-id={w.yt} aria-label={`Play ${w.title}`}>
              <img src={`https://i.ytimg.com/vi/${w.yt}/hqdefault.jpg`} alt={w.title} loading="lazy" />
              <span class="play">▶</span>
            </button>
          ) : (
            <a class="thumb" href={w.href} target="_blank">
              <img src={w.image} alt={w.title} loading="lazy" />
            </a>
          )}
          <div class="card-head">
            <span class="work-title">{w.title}</span>
            <span class="work-year">{w.year}</span>
          </div>
          <p class="card-desc">{w.desc}</p>
          {w.links.length > 0 && (
            <div class="card-links">
              {w.links.map(l => <a href={l.url} target="_blank">{l.label} →</a>)}
            </div>
          )}
        </article>
      ))}
    </div>

    {lists.map(group => (
      <section class="work-list">
        <h3>{group.heading}</h3>
        <ul class="compact">
          {group.items.map(i => (
            <li>
              <span class="li-title">{i.title}</span>
              <span class="li-year">{i.year}</span>
              {i.note && <span class="li-note">{i.note}</span>}
              {i.url && <a href={i.url} target="_blank">{i.link} →</a>}
            </li>
          ))}
        </ul>
        {group.footnote && <p class="footnote"><em>{group.footnote}</em></p>}
      </section>
    ))}

    <h2 id="blog">blog~</h2>
    <a href="/writings" class="blog-link-box">
      <p class="blog-desc">Notes on my research, some interesting things, and personal reflections.</p>
      <p class="blog-cta">→ read more</p>
    </a>

    <h2 id="services">services~</h2>
    <ul class="services">
      <li><strong>Interactive Sound Design</strong>: Max/MSP, Audio-Visual Synchronization, Custom Controller Mapping</li>
      <li><strong>Digital Music Production</strong>: Ableton Live, Electronic Music, Digital Arrangement</li>
      <li><strong>Game Audio Design</strong>: Wwise, game theme song, sound fx design</li>
      <li><strong>Performance</strong>: Studio Session, Live Feature, Live Electronic Performance</li>
    </ul>

    <p class="footer-contact">
      for collaborations, commissions, or inquiries:<br />
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
      <span class="email-protect" data-user="piinannw" data-domain="gmail.com"></span>
    </p>

    <div class="footer-logo">
      <img src="/favicon.png" alt="平安" />
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.email-protect').forEach(el => {
    const user = el.dataset.user;
    const domain = el.dataset.domain;
    const a = document.createElement('a');
    a.href = `mailto:${user}@${domain}`;
    a.textContent = `${user}@${domain}`;
    el.appendChild(a);
  });

  // Load the YouTube player only when a thumbnail is clicked
  document.querySelectorAll('.thumb.yt').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.allow = 'autoplay; encrypted-media; fullscreen';
      iframe.allowFullscreen = true;
      iframe.title = btn.getAttribute('aria-label') || 'video';
      const box = document.createElement('div');
      box.className = 'thumb';
      box.appendChild(iframe);
      btn.replaceWith(box);
    });
  });
</script>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* Header */
  .header {
    display: flex;
    gap: 28px;
    align-items: center;
    margin-bottom: 20px;
  }

  .profile-img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--pink);
    box-shadow: 0 0 20px var(--pink-glow);
    flex-shrink: 0;
  }

  .header-text { flex: 1; min-width: 0; }

  h1 {
    font-size: 2.4em;
    margin: 0 0 4px;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: var(--pink);
    font-family: var(--mono);
    font-size: 0.95em;
    margin: 0 0 4px;
  }

  .academic-name {
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.85em;
    margin: 0 0 4px;
  }

  .location {
    color: var(--text-dim);
    font-size: 0.9em;
    margin: 4px 0 0;
  }

  /* Nav */
  .nav {
    margin: 30px 0 24px;
    padding: 14px 0;
    border-top: 1px dashed rgba(255, 79, 180, 0.3);
    border-bottom: 1px dashed rgba(255, 79, 180, 0.3);
    font-family: var(--mono);
    font-size: 0.9em;
  }
  .nav a {
    margin-right: 22px;
    color: var(--pink-soft);
  }
  .nav a:hover { color: var(--pink); }

  /* Contact */
  .contact {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--text-dim);
    line-height: 1.9;
  }

  /* Object-box style headers */
  h2 {
    display: inline-block;
    margin: 60px 0 24px;
    padding: 6px 14px 6px 24px;
    border: 1.5px solid var(--pink);
    color: var(--pink);
    font-family: var(--mono);
    font-size: 1.05em;
    font-weight: normal;
    letter-spacing: 0.02em;
    position: relative;
    background: rgba(255, 79, 180, 0.06);
  }

  h2::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 6px var(--pink-glow);
  }

  h3 {
    color: var(--pink-soft);
    font-family: var(--mono);
    font-size: 0.95em;
    font-weight: normal;
    margin: 36px 0 16px;
    letter-spacing: 0.05em;
  }

  h3::before {
    content: "// ";
    color: var(--text-dim);
  }

  .statement {
    font-style: italic;
    color: var(--text);
    border-left: 2px solid var(--pink);
    padding: 4px 0 4px 18px;
    margin: 24px 0;
    font-size: 1.02em;
  }

  .label {
    color: var(--pink-soft);
    font-family: var(--mono);
    font-weight: normal;
  }

  /* Selected names row */
  .selected {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--text);
    padding: 14px 16px;
    border: 1px dashed rgba(255, 79, 180, 0.3);
    border-radius: 3px;
    line-height: 1.7;
  }
  .selected-label {
    display: block;
    color: var(--text-dim);
    font-size: 0.85em;
    margin-bottom: 4px;
  }

  /* Featured grid: 3 columns desktop, 2 tablet, 1 phone */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 22px;
  }

  .card { min-width: 0; }

  .thumb {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid rgba(255, 79, 180, 0.2);
    background: #000;
    padding: 0;
    cursor: pointer;
  }
  a.thumb { border-bottom: 1px solid rgba(255, 79, 180, 0.2); }

  .thumb img {
    position: absolute;
    inset: 0;
    margin: 0;
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s, opacity 0.3s;
  }
  .thumb:hover img { transform: scale(1.03); opacity: 0.85; }

  .thumb iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: 1.5px solid var(--pink);
    color: var(--pink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    padding-left: 3px;
  }

  .card-head { margin: 12px 0 4px; }

  .work-title {
    font-weight: 600;
    color: var(--pink);
    font-family: var(--mono);
    font-size: 0.95em;
  }

  .work-year {
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.82em;
    margin-left: 6px;
  }

  .card-desc {
    margin: 4px 0 8px;
    color: var(--text);
    font-size: 0.9em;
    line-height: 1.5;
  }

  .card-links a {
    white-space: nowrap;
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.82em;
    margin-right: 12px;
  }

  /* Compact lists */
  .work-list { margin-top: 12px; }

  ul.compact {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  ul.compact li {
    padding: 10px 0;
    border-bottom: 1px dashed rgba(255, 79, 180, 0.15);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  ul.compact li::before { content: none; }

  .li-title { color: var(--text); font-weight: 600; }
  .li-year { color: var(--text-dim); font-family: var(--mono); font-size: 0.82em; }
  .li-note { color: var(--text-dim); font-size: 0.9em; }
  ul.compact a { font-family: var(--mono); font-size: 0.82em; margin-left: auto; }

  .footnote { margin: 10px 0 0; font-size: 0.9em; }

  /* Blog link box */
  .blog-link-box {
    display: block;
    margin: 28px 0 36px;
    padding: 24px 28px;
    background: rgba(255, 208, 236, 0.03);
    border: 1.5px dashed rgba(255, 208, 236, 0.4);
    border-radius: 3px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.2s, border-color 0.2s;
  }
  .blog-link-box:hover {
    background: rgba(255, 208, 236, 0.06);
    border-color: var(--pink-pale);
    border-bottom-color: var(--pink-pale);
  }
  .blog-desc {
    color: var(--text) !important;
    margin: 0 0 8px;
    font-size: 1em;
  }
  .blog-cta {
    color: var(--pink);
    font-family: var(--mono);
    font-size: 0.9em;
    margin: 0;
  }

  /* Services list */
  ul.services {
    padding-left: 0;
    list-style: none;
  }
  ul.services li {
    margin: 12px 0;
    position: relative;
    padding-left: 18px;
  }
  ul.services li::before {
    content: "▸";
    color: var(--pink);
    position: absolute;
    left: 0;
  }
  ul.services li strong {
    color: var(--pink-soft);
    font-family: var(--mono);
    font-weight: normal;
  }

  em { color: var(--text-dim); }

  /* Footer */
  .footer-contact {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px dashed rgba(255, 79, 180, 0.3);
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.88em;
  }
  .footer-logo {
    text-align: center;
    margin-top: 60px;
    opacity: 0.7;
  }
  .footer-logo img {
    width: 80px;
    height: auto;
  }

  @media (max-width: 860px) {
    .featured-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .header { flex-direction: column; align-items: flex-start; gap: 16px; }
    .profile-img { width: 110px; height: 110px; }
    h1 { font-size: 2em; }
    .featured-grid { grid-template-columns: 1fr; }
    ul.compact a { margin-left: 0; }
  }
</style>